{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "GP Cloud",
  "version": "1.0.0",
  "identifier": "io.github.azs06.gpcloud-desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "GP Cloud",
        "width": 1200,
        "height": 760,
        "minWidth": 860,
        "minHeight": 540,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' https: data: blob:; style-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "publisher": "Md Atiquzzaman Soikat",
    "copyright": "Unofficial client. Not affiliated with Grameenphone. MIT License.",
    "category": "Productivity",
    "shortDescription": "Unofficial GP Cloud client",
    "longDescription": "Unofficial desktop client for Grameenphone GP Cloud storage: browse, upload, download and manage your files.",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "windows": {
      "nsis": { "installMode": "currentUser" },
      "webviewInstallMode": { "type": "downloadBootstrapper" }
    }
  }
}
